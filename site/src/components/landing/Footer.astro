---
import { url, repo, download, docsHome } from "../../lib/url";
import { version } from "../../lib/data";
---

<section class="finale" aria-labelledby="cta-title">
  <div class="glow" aria-hidden="true"></div>
  <div class="wrap center">
    <h2 class="h2" id="cta-title" data-reveal>Give your desktop <em>something to say.</em></h2>
    <p class="sub" data-reveal="0.05">Free, open source and a two-minute install. No account, no admin prompt.</p>
    <div class="buttons" data-reveal="0.1">
      <a class="btn primary magnetic" href={download}>
        <svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11m-5-5 5 5 5-5M5 20h14" /></svg>
        Download Umbra {version}
      </a>
      <a class="btn ghost magnetic" href={docsHome}>Read the docs</a>
    </div>
    <p class="fine" data-reveal="0.15">Windows 10 (1809+) and Windows 11 · <a href={`${repo}/releases`}>Portable zip and all releases</a></p>
  </div>
  <div class="word" aria-hidden="true"><span>UMBRA</span></div>
</section>

<footer class="foot">
  <div class="wrap row">
    <a class="brand" href={url("")}><img src={url("favicon.png")} alt="" width="24" height="24" />Umbra</a>
    <span class="dim">MIT licensed · Made by the community · No tracking</span>
    <nav aria-label="Project">
      <a href={docsHome}>Docs</a>
      <a href={url("widgets/")}>Widgets</a>
      <a href={repo}>GitHub</a>
      <a href={`${repo}/releases`}>Releases</a>
      <a href={`${repo}/issues/new/choose`}>Report an issue</a>
      <a href={`${repo}/blob/main/SECURITY.md`}>Security</a>
    </nav>
  </div>
</footer>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);
  gsap.matchMedia().add("(prefers-reduced-motion: no-preference)", () => {
    const cta = document.querySelector<HTMLElement>(".finale")!;
    // The wordmark rises into place and the glow slides behind it as the section scrolls into view.
    gsap.fromTo(cta.querySelector(".word span"), { yPercent: 35, opacity: 0.2 }, { yPercent: 0, opacity: 1, ease: "none", scrollTrigger: { trigger: cta, start: "top 80%", end: "bottom bottom", scrub: true } });
    gsap.fromTo(cta.querySelector(".glow"), { xPercent: -30, opacity: 0.3 }, { xPercent: 25, opacity: 1, ease: "none", scrollTrigger: { trigger: cta, start: "top bottom", end: "bottom bottom", scrub: true } });
  });
</script>

<style>
  .finale { position: relative; overflow: hidden; padding: clamp(110px, 16vw, 200px) 0 0; isolation: isolate; }
  .center { text-align: center; display: flex; flex-direction: column; align-items: center; }
  .center .h2 { max-width: 14ch; font-size: clamp(2.6rem, 7vw, 6rem); }
  .center .sub { margin-bottom: 36px; }
  .buttons { display: flex; flex-wrap: wrap; justify-content: center; gap: 14px; }
  .fine { color: var(--text3); font-size: .86rem; margin: 26px 0 0; }
  .glow { position: absolute; left: 50%; bottom: -10%; width: min(1100px, 120vw); aspect-ratio: 2; translate: -50% 0; z-index: -1; border-radius: 50%; background: radial-gradient(closest-side, rgba(139, 147, 255, .55), rgba(139, 147, 255, .12) 55%, transparent 75%); filter: blur(30px); }
  .word { margin-top: clamp(24px, 6vw, 80px); overflow: hidden; line-height: .8; text-align: center; user-select: none; }
  .word span { display: block; font: 800 clamp(5rem, 27vw, 26rem)/.82 var(--display); letter-spacing: -.06em; margin-bottom: -.06em; background: linear-gradient(180deg, #fff 8%, rgba(169, 175, 255, .55) 55%, rgba(139, 147, 255, 0) 98%); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .foot { position: relative; border-top: 1px solid var(--line); padding: 30px 0 40px; background: #000; font-size: .88rem; }
  .row { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 32px; }
  .brand { display: flex; align-items: center; gap: 9px; color: var(--text); font: 650 1rem/1 var(--display); }
  .brand:hover { color: var(--text); }
  .dim { color: var(--text3); }
  nav { display: flex; flex-wrap: wrap; gap: 8px 22px; margin-left: auto; }
  nav a { color: var(--text2); }
  nav a:hover { color: var(--text); }
  @media (max-width: 720px) { nav { margin-left: 0; } }
</style>
