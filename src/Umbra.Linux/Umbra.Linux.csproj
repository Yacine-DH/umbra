<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Linux host (KDE Plasma 6, GNOME 46+): GTK4 + WebKitGTK 6 through GirCore. Epic #172. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifiers>linux-x64;linux-arm64</RuntimeIdentifiers>
    <AssemblyName>umbra</AssemblyName>
    <RootNamespace>Umbra</RootNamespace>
    <Description>Desktop widgets that live on your wallpaper.</Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Umbra.Linux.Tests" />
    <!-- GTK and WebKitGTK exist only on Linux; this tells the platform analyzer the whole host is Linux-only. -->
    <AssemblyAttribute Include="System.Runtime.Versioning.SupportedOSPlatformAttribute">
      <_Parameter1>linux</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Umbra.Core\Umbra.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The only bindings the Linux host uses (epic #172): GTK4 and WebKitGTK 6. They bring Gio, so D-Bus needs no package. -->
    <PackageReference Include="GirCore.Gtk-4.0" Version="0.8.1" />
    <PackageReference Include="GirCore.WebKit-6.0" Version="0.8.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\shared\**\*" LinkBase="shared" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\settings\**\*" LinkBase="settings" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- The app icon (hicolor theme): window icon, tray icon (and its attention variant), later the .desktop entry. -->
    <Content Include="..\..\linux\icons\**\*" LinkBase="icons" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- The GNOME Shell extension (#187), so Settings can offer to install it and install.sh can copy it. -->
    <Content Include="..\..\linux\gnome-extension\**\*" LinkBase="gnome-extension" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    The web-process extension that enforces the widget sandbox (native/umbra-webext.c, #180). Compiled with gcc against
    webkitgtk-web-process-extension-6.0 (Ubuntu: libwebkitgtk-6.0-dev) and shipped as webext/libumbra-webext.so next to the
    binary. Linux only: on Windows the project still compiles (the solution builds everywhere) but produces no extension.
  -->
  <PropertyGroup>
    <WebExtSource>$(MSBuildProjectDirectory)/native/umbra-webext.c</WebExtSource>
    <!-- The C compiler: aarch64-linux-gnu-gcc for an arm64 cross build (linux/package.sh passes WEBEXT_CC; pkg-config then needs PKG_CONFIG_LIBDIR). -->
    <WebExtCC Condition="'$(WebExtCC)' == ''">gcc</WebExtCC>
    <!-- Per runtime identifier, so an x64 build is never reused for linux-arm64 (package.sh also checks the ELF machine). -->
    <WebExtOutput>$(MSBuildProjectDirectory)/obj/webext/$(RuntimeIdentifier)/libumbra-webext.so</WebExtOutput>
  </PropertyGroup>

  <Target Name="BuildWebExtension" BeforeTargets="AssignTargetPaths" Condition="$([MSBuild]::IsOSPlatform('Linux'))"
          Inputs="$(WebExtSource)" Outputs="$(WebExtOutput)">
    <Exec Command="pkg-config --exists webkitgtk-web-process-extension-6.0" IgnoreExitCode="true" StandardOutputImportance="low">
      <Output TaskParameter="ExitCode" PropertyName="WebExtPkgExit" />
    </Exec>
    <Error Condition="'$(WebExtPkgExit)' != '0'"
           Text="The sandbox extension needs gcc, pkg-config and the WebKitGTK 6 development files (Ubuntu: sudo apt install build-essential pkg-config libwebkitgtk-6.0-dev)." />
    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(WebExtOutput)'))" />
    <Exec Command="$(WebExtCC) -shared -fPIC -O2 -Wall -Wextra -Werror -Wno-unused-parameter &quot;$(WebExtSource)&quot; %24(pkg-config --cflags --libs webkitgtk-web-process-extension-6.0) -o &quot;$(WebExtOutput)&quot;" />
  </Target>

  <Target Name="IncludeWebExtension" BeforeTargets="AssignTargetPaths" DependsOnTargets="BuildWebExtension" Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <ItemGroup>
      <Content Include="$(WebExtOutput)" Link="webext/libumbra-webext.so" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

</Project>
