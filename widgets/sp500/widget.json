{
  "$schema": "https://raw.githubusercontent.com/AmineChr54/umbra/main/schemas/widget.schema.json",
  "id": "sp500",
  "name": "S&P 500",
  "description": "Live index price, daily change and a smooth intraday chart. Works with any Yahoo Finance symbol.",
  "author": "AmineChr54",
  "version": "1.1.4",
  "category": "markets",
  "manifestVersion": 1,
  "entry": "index.html",
  "preview": "preview.png",
  "icon": "icon.png",
  "width": 340,
  "height": 196,
  "defaultPosition": { "x": 24, "y": 24 },
  "permissions": {
    "hosts": ["query1.finance.yahoo.com"]
  },
  "options": {
    "symbol": { "label": "Symbol", "type": "text", "default": "^GSPC", "hint": "Any Yahoo Finance symbol, e.g. ^IXIC, ^DJI, AAPL" },
    "label": { "label": "Display name", "type": "text", "default": "", "hint": "Leave empty to use the symbol's own name" },
    "range": {
      "label": "Chart range",
      "type": "select",
      "default": "1d",
      "choices": [
        { "value": "1d", "label": "1 day" },
        { "value": "5d", "label": "5 days" }
      ]
    }
  }
}
