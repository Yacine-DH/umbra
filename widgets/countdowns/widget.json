{
  "$schema": "https://raw.githubusercontent.com/AmineChr54/umbra/main/schemas/widget.schema.json",
  "id": "countdowns",
  "name": "Countdowns",
  "description": "Count down to birthdays, trips and deadlines as dot grids, bars or rings, plus how far this year, month or week has gone. Add and edit right in the widget.",
  "author": "AmineChr54",
  "version": "1.0.7",
  "category": "time",
  "changelog": "The emoji box only mentions Win + . on Windows.",
  "manifestVersion": 1,
  "entry": "index.html",
  "preview": "preview.png",
  "icon": "icon.png",
  "width": 360,
  "height": 462,
  "defaultPosition": { "x": 380, "y": 400 },
  "permissions": { "hosts": [] },
  "options": {
    "title": { "label": "Title", "type": "text", "default": "Countdowns" },
    "sort": { "label": "Order", "type": "select", "default": "soonest",
              "choices": [{ "value": "soonest", "label": "Soonest first" }, { "value": "added", "label": "As added" }] },
    "weekStart": { "label": "Weeks start on", "type": "select", "default": "monday",
                   "choices": [{ "value": "monday", "label": "Monday" }, { "value": "sunday", "label": "Sunday" }] },
    "showPast": { "label": "Keep past one-off events", "type": "toggle", "default": true,
                  "hint": "Off hides events once their day has passed. They stay saved until you delete them." }
  }
}
