{
  "$schema": "https://raw.githubusercontent.com/AmineChr54/umbra/main/schemas/widget.schema.json",
  "id": "prayer-times",
  "name": "Prayer Times",
  "description": "Daily prayer times with a live countdown to the next prayer, optional iqama times and Hijri date. Pick your city in the widget; times are calculated by coordinates with the Aladhan API (no key) and the method follows your country.",
  "author": "Yacine-DH",
  "version": "1.2.5",
  "category": "time",
  "manifestVersion": 1,
  "entry": "index.html",
  "preview": "preview.png",
  "width": 300,
  "height": 380,
  "defaultPosition": {
    "x": 340,
    "y": 24
  },
  "permissions": {
    "hosts": [
      "api.aladhan.com",
      "geocoding-api.open-meteo.com"
    ],
    "notifications": true
  },
  "options": {
    "timeFormat": {
      "label": "Time format",
      "type": "select",
      "default": "auto",
      "choices": [
        {
          "value": "auto",
          "label": "Follow system (24-hour if unknown)"
        },
        {
          "value": "24",
          "label": "24-hour"
        },
        {
          "value": "12",
          "label": "12-hour"
        }
      ]
    },
    "hijri": {
      "label": "Show Hijri date",
      "type": "toggle",
      "default": true
    },
    "adjustFajr": {
      "group": "Time adjustments",
      "label": "Fajr adjustment (min)",
      "type": "number",
      "default": 0,
      "min": -30,
      "max": 30,
      "step": 1,
      "hint": "Minutes added to the calculated time to match your mosque. Negative = earlier."
    },
    "adjustDhuhr": {
      "group": "Time adjustments",
      "label": "Dhuhr adjustment (min)",
      "type": "number",
      "default": 0,
      "min": -30,
      "max": 30,
      "step": 1
    },
    "adjustAsr": {
      "group": "Time adjustments",
      "label": "Asr adjustment (min)",
      "type": "number",
      "default": 0,
      "min": -30,
      "max": 30,
      "step": 1
    },
    "adjustMaghrib": {
      "group": "Time adjustments",
      "label": "Maghrib adjustment (min)",
      "type": "number",
      "default": 0,
      "min": -30,
      "max": 30,
      "step": 1
    },
    "adjustIsha": {
      "group": "Time adjustments",
      "label": "Isha adjustment (min)",
      "type": "number",
      "default": 0,
      "min": -30,
      "max": 30,
      "step": 1
    },
    "iqamaFajr": {
      "group": "Iqama delays",
      "label": "Fajr iqama delay (min)",
      "type": "number",
      "default": 0,
      "min": 0,
      "max": 90,
      "step": 1,
      "hint": "Minutes from adhan to iqama (jama’ah). 0 hides the iqama time."
    },
    "iqamaDhuhr": {
      "group": "Iqama delays",
      "label": "Dhuhr iqama delay (min)",
      "type": "number",
      "default": 0,
      "min": 0,
      "max": 90,
      "step": 1
    },
    "iqamaAsr": {
      "group": "Iqama delays",
      "label": "Asr iqama delay (min)",
      "type": "number",
      "default": 0,
      "min": 0,
      "max": 90,
      "step": 1
    },
    "iqamaMaghrib": {
      "group": "Iqama delays",
      "label": "Maghrib iqama delay (min)",
      "type": "number",
      "default": 0,
      "min": 0,
      "max": 90,
      "step": 1
    },
    "iqamaIsha": {
      "group": "Iqama delays",
      "label": "Isha iqama delay (min)",
      "type": "number",
      "default": 0,
      "min": 0,
      "max": 90,
      "step": 1
    },
    "notify": {
      "label": "Notify at adhan",
      "type": "toggle",
      "default": false,
      "hint": "Also set Notifications to On (or Default with notifications allowed in General) for this widget in Settings."
    }
  }
}
