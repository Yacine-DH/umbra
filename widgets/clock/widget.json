{
  "$schema": "https://raw.githubusercontent.com/AmineChr54/umbra/main/schemas/widget.schema.json",
  "id": "clock",
  "name": "Clock",
  "description": "A quiet, OLED-friendly clock with the date and a slim progress ring for the current minute.",
  "author": "AmineChr54",
  "version": "1.1.5",
  "category": "time",
  "manifestVersion": 1,
  "entry": "index.html",
  "preview": "preview.png",
  "icon": "icon.png",
  "width": 260,
  "height": 128,
  "defaultPosition": { "x": 24, "y": 240 },
  "permissions": { "hosts": [] },
  "options": {
    "timeFormat": {
      "label": "Time format", "type": "select", "default": "auto",
      "choices": [{ "value": "auto", "label": "Follow system" }, { "value": "24", "label": "24-hour" }, { "value": "12", "label": "12-hour" }]
    },
    "seconds": { "label": "Show seconds", "type": "toggle", "default": false }
  }
}
